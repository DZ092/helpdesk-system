# Copie este arquivo para .env e preencha com os seus valores.
# O .env NUNCA deve ser commitado — ele já está listado no .gitignore.

# Chave que assina o cookie de sessão. Gere a sua com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# A aplicação se recusa a subir sem esta variável.
SECRET_KEY=

# Credenciais de envio de e-mail (use uma Senha de App do Gmail, nunca a senha da conta).
MAIL_USERNAME=
MAIL_PASSWORD=

# Upload de anexos de imagem nos chamados (issue #6). Sem estas três variáveis
# o upload é silenciosamente ignorado — o chamado ou comentário continua sendo
# salvo normalmente, só sem o anexo. Crie uma conta gratuita em cloudinary.com
# e pegue as três no painel (Dashboard > Product Environment Credentials).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcionais
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# DATABASE_URL=sqlite:///chamados.db

# Domínio usado no redirect HTTPS e nos links enviados por e-mail (redefinição
# de senha), em vez de confiar no cabeçalho Host da requisição. Sem esta
# variável, a aplicação usa "helpdesk-system-cci1.onrender.com" — troque para
# o seu domínio de produção, ou para "localhost:5000" se quiser testar
# localmente o link recebido por e-mail.
HOST_CONFIAVEL=helpdesk-system-cci1.onrender.com

# Captcha nos formulários públicos (cadastro, abrir chamado, esqueci senha).
# Crie um widget gratuito em dash.cloudflare.com > Turnstile e pegue as duas
# chaves lá. Sem a Secret Key, os formulários funcionam normalmente, só sem
# essa proteção (ver TURNSTILE_ENABLED em app.py).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Login com Google (issue #95). Crie um projeto em console.cloud.google.com >
# APIs & Services > Credentials > OAuth client ID (tipo "Web application").
# Em "Authorized redirect URIs" cadastre:
#   http://localhost:5000/login/google/callback (para testar localmente)
#   https://SEU-DOMINIO/login/google/callback (produção, troque pelo domínio real)
# Sem GOOGLE_CLIENT_SECRET, o botão "Entrar com Google" some das telas de
# login e cadastro (ver GOOGLE_OAUTH_ENABLED em app.py) e tudo mais segue
# funcionando normalmente por e-mail/senha.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Coloque 1 em produção (HTTPS) para que o cookie de sessão só trafegue criptografado.
SESSION_COOKIE_SECURE=0

# Coloque 1 apenas em desenvolvimento local para ligar o debugger do Flask.
# Nunca em produção: o debugger permite execução remota de código.
FLASK_DEBUG=0